# KuikChat local environment template
# Copy to .env.local and fill values. Never commit .env.local or real secrets.
# Names only — leave values empty.

# ---------------------------------------------------------------------------
# Supabase browser configuration (safe for Vite)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alias used by some client paths
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Local server / admin scripts only — NEVER prefix with VITE_
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVER_URL=

# ---------------------------------------------------------------------------
# Hermes text — Langdock (production primary)
# Live Edge Function currently expects legacy names:
#   LANGDOCK_API_KEY, LANGDOCK_MODEL
# Prefer these clearer local names once Edge secrets are migrated:
# ---------------------------------------------------------------------------
LANGDOCK_API_KEY=
LANGDOCK_MODEL=
LANGDOCK_ENDPOINT_URL=
# Preferred future aliases (map to the same Edge secrets until renamed):
# LANGDOCK_CHAT_API_KEY=
# LANGDOCK_CHAT_MODEL=
# LANGDOCK_CHAT_ENDPOINT_URL=

# Operational circuit breaker for Langdock (Edge secret; "true" disables Langdock)
# AI_LANGDOCK_DISABLED=false

# ---------------------------------------------------------------------------
# Logicc — approved secondary text provider (inactive until role + token approved)
# ---------------------------------------------------------------------------
LOGICC_API_KEY=
LOGICC_ENDPOINT_URL=
LOGICC_MODEL=
# AI_LOGICC_FALLBACK_ENABLED=false

# Legacy local aliases observed in some workstations (do not add duplicates):
# LOGICC_API=   -> use LOGICC_API_KEY
# MODEL=        -> use LANGDOCK_MODEL / LOGICC_MODEL (never a bare MODEL)

# ---------------------------------------------------------------------------
# Langdock agents — not wired to product UI until sharing/workspace verified
# ---------------------------------------------------------------------------
LANGDOCK_IMAGE_API_KEY=
LANGDOCK_IMAGE_AGENT_ID=
LANGDOCK_IMAGE_WORKSPACE_ID=

LANGDOCK_DOC_API_KEY=
LANGDOCK_DOC_AGENT_ID=
LANGDOCK_DOC_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Optional / unwired media providers — inactive until separately approved
# ---------------------------------------------------------------------------
# KLING_AI_API_KEY=
# GROK_API_KEY=

# ---------------------------------------------------------------------------
# Optional server-side gateway / orchestration — inventory before use
# ---------------------------------------------------------------------------
# MASTRA_GATEWAY_API_KEY=
# MASTRA_GATEWAY_URL=

# Do not store long-lived JWTs here. Maintained scripts must obtain short-lived
# sessions through an approved authentication flow.
